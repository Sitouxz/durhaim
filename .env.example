# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin command center
ADMIN_PASSWORD=your-admin-password
# Signs admin session cookies. Falls back to SUPABASE_SERVICE_ROLE_KEY when unset,
# which means rotating the service key would log every admin out — set it explicitly.
ADMIN_SESSION_SECRET=your-long-random-string

# Optional. Owner account allowed to bootstrap a password before one is hashed.
# Defaults to admin@durhaim.com.
# ADMIN_BOOTSTRAP_EMAIL=admin@durhaim.com

# Optional. Direct Postgres connection, used only by scripts in scripts/ — not by the app.
# SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
